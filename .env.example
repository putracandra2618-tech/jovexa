APP_NAME=Jovexa
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ADMIN_NAME="Admin Jovexa"
ADMIN_EMAIL=admin@jovexa.test
# Wajib diisi dengan password kuat sebelum menjalankan `php artisan db:seed`.
ADMIN_PASSWORD=

SUPER_ADMIN_NAME="Putra Candra"
SUPER_ADMIN_EMAIL=
# Wajib diisi sebelum menjalankan `php artisan db:seed`.
SUPER_ADMIN_PASSWORD=

# Payment gateway. Checkout and callbacks stay disabled until all three
# credentials below are set.
TRIPAY_API_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_PRIVATE_KEY=
# Use false for sandbox, true for production.
TRIPAY_IS_PRODUCTION=false
TRIPAY_CHANNEL_CACHE_SECONDS=300
# Batas waktu pembayaran dalam menit (10-4320). Default 1440 (24 jam).
TRIPAY_EXPIRY_MINUTES=1440

VITE_APP_NAME="${APP_NAME}"

# Trust TLS-terminating proxies (ngrok/load balancer). Empty = no trust.
TRUSTED_PROXIES=

# Public contact shown in the site header, footer, and service detail pages.
# Format: country code + number, without "+" or dashes, e.g. 6281234567890
JOVEXA_WHATSAPP=
JOVEXA_CONTACT_EMAIL=
