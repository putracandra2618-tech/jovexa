{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ],
            "environment": {
                "APP_ENV": "local",
                "BOOST_BROWSER_LOGS_WATCHER": "false"
            }
        }
    }
}
